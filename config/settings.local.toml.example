# ══════════════════════════════════════════════════════════════
#  你自己的调整（settings.local.toml）
#
#  这个文件**部署时永远不会被覆盖**。用法：
#    1. 把它复制成 settings.local.toml（去掉 .example）
#    2. 只写你要改的那几项
#
#  没写的项自动用仓库 config/settings.toml 里的默认值 —— 所以我以后
#  改了默认值，你能**自动拿到**；你写在这里的值永远是你的。
#
#  为什么要有这一层：以前是"整份 settings.toml 都不覆盖"，看着安全，
#  其实有个很难发现的坑 —— toml 里写了某个键，它就压过代码默认值，
#  于是我在代码里修好一个默认阈值、部署上去，**服务器上根本没生效**，
#  而且没有任何提示。分层之后两边各管各的，谁都不会被对方吃掉。
# ══════════════════════════════════════════════════════════════

# ── 例：她在群里有多活跃 ──────────────────────────────────────
# [runtime]
# response_tier     = 70     # 0~100：0 只应 @，45 按概率接话，70+ 什么话都可能接
# speak_max_per_day = 6      # 每个群每天最多自己插几次嘴（不含被 @ 的）
# wake_delay_seconds = 2.0   # 被触发后等她说完再回；0 = 听到就回

# ── 例：她主动找你 ───────────────────────────────────────────
# [outreach]
# max_per_day    = 3         # 每天最多主动几次
# min_gap_hours  = 3         # 两次之间至少隔多久
# idle_days      = 2         # 多久没说话就算"想你了"
# quiet_from     = "23:30"   # 安静时段：这段时间她不主动吵你（跨午夜）
# quiet_to       = "08:00"
# target         = "both"    # owner 只私聊 | group 只发群 | both

# ── 例：她记性有多好 ─────────────────────────────────────────
# [memory]
# retention_unit_hours = 720 # 调大 = 记得更牢，调小 = 忘得更快
# consolidate_every    = 6   # 每攒多少条消息整理一次记忆
# session_window       = 40  # 每次请求带上的最近消息条数
# tools_enabled        = true  # 让她能在对话中主动记一笔 / 查一下

# ── 例：她的寿命 ─────────────────────────────────────────────
# [lifespan]
# total_hours = 81920        # 约 9 年 4 个月
