# ══════════════════════════════════════════════════════════════
#  你自己改的人格（persona.local.toml）
#
#  这个文件**部署时永远不会被覆盖**。用法：
#    1. 把它复制成 persona.local.toml（去掉 .example）
#    2. 只写你要改的那几项
#
#  没写的项自动用仓库 config/persona.toml 里的内容。想彻底换掉她，
#  就把 core 整段写进来（那一段是"她是谁"）。
#
#  表（[bond.stages.*] / [moods.*]）是**整段替换**的：你写了
#  [moods.happy]，就只有这一项被替换，其它心情仍然用仓库里的。
# ══════════════════════════════════════════════════════════════

# ── 例：换个名字 / 称呼 ──────────────────────────────────────
# name          = "艾拉"
# model_code    = "Giftia-Type-07"
# handler_title = "他"        # 还不知道你名字时，她用什么代称

# ── 例：改她的人格内核（整段替换，写之前先看仓库那份的语气）──
# core = """
# （这里写"她是谁"。她说话的依据全在这一段。）
# """

# ── 例：改某个关系阶段她怎么说话 ─────────────────────────────
# [bond.stages.close]
# label = "亲近"
# tone  = "（这一段写她进入这个阶段后的语气）"

# ── 例：改某一种心情 ─────────────────────────────────────────
# [moods.happy]
# label = "开心"
# tone  = "（这一段写她开心时的语气）"
