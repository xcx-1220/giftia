[Unit]
Description=Giftia —— DeepSeek 陪伴机器人（QQ 官方机器人适配器）
Documentation=file:/opt/giftia/README.md
After=network-online.target
Wants=network-online.target

# 崩溃重启的上限：Restart=always 碰上"凭据填了但无效"（AppSecret 过期）会每 5 秒
# 无限重启、日志刷屏。60 秒内最多 3 次，超过就停下来等人看 systemctl status。
# 注意：这两个指令的有效位置是 [Unit]，写在 [Service] 里会被 systemd 忽略。
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=giftia
Group=giftia
WorkingDirectory=/opt/giftia

# 零第三方依赖，直接用系统 python3（需要 3.11+，setup.sh 会检查）
# 如果你把 python 装在别处，改这一行即可
#
# --web-port：同时开网站入口（**一个进程、两个入口**）。
#   · HTTP 线程只入队，真正的执行在这个进程的主循环里 —— 她不是线程安全的
#   · 只监听 127.0.0.1:8111，**不对外开任何端口**；公网走 cloudflared 隧道
#   · 门禁口令在 /opt/giftia/.env 的 AILA_WEB_SECRET（没配就不开这个入口）
ExecStart=/usr/bin/python3 /opt/giftia/adapters/qq_official.py --web-port 8111

# 退出与重启
Restart=always
RestartSec=5

# 停止时先发 SIGTERM：她会借这段时间把还没整理的对话存成记忆，再关掉数据库
KillSignal=SIGTERM
TimeoutStopSec=60

# 日志交给 journald：journalctl -u giftia-qq -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=giftia-qq

# 环境变量必须是 [Service] 里的指令，**不能**写成 [Environment] 段 ——
# 写成段 systemd 会报 "Unknown section 'Environment'. Ignoring." 全部忽略，
# 于是 PYTHONUNBUFFERED 失效，日志会卡在输出缓冲里看不到。
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
# 代码目录是只读的，别让 Python 试图写 .pyc
Environment=PYTHONDONTWRITEBYTECODE=1

# ── 加固：整个文件系统对她只读，只有 data/ 能写 ──────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/giftia/data

[Install]
WantedBy=multi-user.target
